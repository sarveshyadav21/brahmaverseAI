{
  "name": "crm-backend",
  "version": "1.0.0",
  "description": "CRM Backend REST API — Node.js, Express, Prisma, PostgreSQL (Neon)",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test:db:up": "docker compose up -d db-test",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.0.0",
    "express-validator": "^7.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.0.0",
    "nodemon": "^3.0.0",
    "prisma": "^6.0.0",
    "supertest": "^6.0.0"
  }
}
