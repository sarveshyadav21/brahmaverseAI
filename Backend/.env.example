PORT=3000
NODE_ENV=development

# Neon Postgres — pooled URL for app queries
DATABASE_URL=postgresql://user:password@endpoint-pooler.neon.tech/dbname?sslmode=require

# Neon Postgres — direct (non-pooled) URL for Prisma migrations
DATABASE_URL_UNPOOLED=postgresql://user:password@endpoint.neon.tech/dbname?sslmode=require

# Local test database (docker-compose db-test service)
DATABASE_URL_TEST=postgresql://crm_user:crm_pass@localhost:5433/crm_db_test

# JWT — must be at least 32 random characters
JWT_SECRET=replace_with_a_long_random_string_of_at_least_32_chars
JWT_EXPIRES_IN=1d

# Password pepper — must be at least 32 random characters, different from JWT_SECRET
PASSWORD_PEPPER=replace_with_another_long_random_string_of_at_least_32_chars

# Bcrypt cost factor (default 10 in dev/prod, 4 in test)
BCRYPT_ROUNDS=10

CORS_ORIGIN=*
